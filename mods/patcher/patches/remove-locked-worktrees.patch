+async function lockOf(top, on) {
+  const gitDir = await git(top, ["rev-parse", "--absolute-git-dir"], on);
+  if (!gitDir.ok) return null;
+  const reason = await readTextFile(`${gitDir.out}/locked`, { on });
+  return reason === null ? null : reason.trim();
+}
+function lockedBy(reason) {
+  try {
+    const owner = JSON.parse(reason)?.owner;
+    if (typeof owner === "string") return ` by ${owner}`;
+  } catch {}
+  return reason ? ` (${reason})` : "";
+}
