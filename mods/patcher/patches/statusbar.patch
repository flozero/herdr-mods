--- a/mods/workspace-status/context.js	1969-12-31 19:00:00
+++ b/mods/workspace-status/context.js	2026-11-23 15:42:51
@@ -0,0 +1,111 @@
+import { exec, appHome, shared, setShared } from "herdr";
+
+export const KEY = "statusbar.context";
+const DAY = 24 * 60 * 60 * 1000;
+const REFRESH_AT = 60 * 1000;
+const MR_QUERY = `query($p: ID!, $b: String!) {
+  currentUser { username name id }
+  project(fullPath: $p) { mergeRequests(sourceBranches: [$b], state: opened, first: 1) { nodes {
+    iid title webUrl draft sourceBranch targetBranch diffHeadSha
+    headPipeline { status path }
+    resolvableDiscussionsCount resolvedDiscussionsCount
+    diffRefs { baseSha headSha startSha }
+  } } }
+}`;
+
+export function issueCandidates(branch) {
+  const out = [];
+  for (const m of String(branch ?? "").matchAll(/(?:^|[^A-Za-z0-9])([A-Za-z][A-Za-z0-9]*)-(\d+)(?![A-Za-z0-9])/g)) {
+    const id = `${m[1].toUpperCase()}-${m[2]}`;
+    if (!out.includes(id)) out.push(id);
+  }
+  return out.slice(0, 3);
+}
+
+export function forgeOf(url) {
+  const m = /^(?:[a-z+]+:\/\/)?(?:[^@/]+@)?([^/:]+)(?::\d+)?[:/](.+?)(?:\.git)?\/?$/.exec(String(url).trim());
+  return m ? { host: m[1], path: m[2] } : null;
+}
+
+const sameEntry = (a, b) => JSON.stringify({ ...a, fetchedAt: 0 }) === JSON.stringify({ ...b, fetchedAt: 0 });
+
+export function merged(all, root, entry, now) {
+  const kept = Object.fromEntries(Object.entries(all ?? {}).filter(([key, value]) => key !== root && now - (value?.fetchedAt ?? 0) < DAY));
+  return { ...kept, [root]: entry };
+}
+
+export function shouldPublish(previous, entry, now) {
+  return !previous || !sameEntry(previous, entry) || now - (previous.fetchedAt ?? 0) >= REFRESH_AT;
+}
+
+export function mrOf(node, host) {
+  if (!node) return null;
+  const status = node.headPipeline?.status ? node.headPipeline.status.toLowerCase() : null;
+  return {
+    iid: Number(node.iid),
+    title: node.title,
+    web_url: node.webUrl,
+    state: "opened",
+    draft: Boolean(node.draft),
+    source_branch: node.sourceBranch,
+    target_branch: node.targetBranch,
+    sha: node.diffHeadSha,
+    diff_refs: node.diffRefs ? { base_sha: node.diffRefs.baseSha, head_sha: node.diffRefs.headSha, start_sha: node.diffRefs.startSha } : null,
+    pipeline: status ? { status, web_url: `https://${host}${node.headPipeline.path}` } : null,
+    openThreads: Math.max(0, (node.resolvableDiscussionsCount ?? 0) - (node.resolvedDiscussionsCount ?? 0)),
+  };
+}
+
+async function gitlabPart(root, branch) {
+  const remote = await exec("git", ["-C", root, "remote", "get-url", "origin"]).catch(() => null);
+  const forge = remote?.code === 0 ? forgeOf(remote.stdout) : null;
+  if (!forge || forge.host.startsWith("github")) return null;
+  const r = await exec("glab", ["api", "graphql", "--hostname", forge.host, "-f", `query=${MR_QUERY}`, "-f", `p=${forge.path}`, "-f", `b=${branch}`], { cwd: root, timeout: 30000 }).catch(() => null);
+  if (!r || r.code !== 0) return undefined;
+  const data = JSON.parse(r.stdout).data;
+  const me = data?.currentUser;
+  return {
+    gitlab: { host: forge.host, project: forge.path, me: me ? { username: me.username, name: me.name, id: Number(String(me.id).split("/").pop()) } : null },
+    mr: mrOf(data?.project?.mergeRequests?.nodes?.[0], forge.host),
+  };
+}
+
+async function linearPart(branch) {
+  const ids = issueCandidates(branch);
+  if (!ids.length) return null;
+  const cli = `${appHome()}/mods/linear/cli/linear-me.mjs`;
+  const calls = JSON.stringify(ids.map((id) => ({ tool: "get_issue", args: { id } })));
+  const r = await exec("node", [cli, "batch", calls], { timeout: 60000 }).catch(() => null);
+  if (!r || r.code !== 0) return undefined;
+  let out = null;
+  try { out = JSON.parse(String(r.stdout).trim().split("\n").pop()); } catch {}
+  if (!out?.ok) return undefined;
+  const at = out.value.findIndex((x) => x.ok && x.value?.title);
+  if (at < 0) return null;
+  const issue = out.value[at].value;
+  return { id: ids[at], title: issue.title, state: issue.status ?? issue.state?.name ?? null, url: issue.url ?? null };
+}
+
+export async function fetchContext(root, branch, previous) {
+  const [gitlab, issue] = await Promise.all([gitlabPart(root, branch).catch(() => undefined), linearPart(branch).catch(() => undefined)]);
+  const keep = previous?.branch === branch ? previous : null;
+  return {
+    branch,
+    fetchedAt: Date.now(),
+    gitlab: gitlab === undefined ? keep?.gitlab ?? null : gitlab?.gitlab ?? null,
+    mr: gitlab === undefined ? keep?.mr ?? null : gitlab?.mr ?? null,
+    issue: issue === undefined ? keep?.issue ?? null : issue,
+  };
+}
+
+export function publish(root, entry) {
+  const all = shared(KEY) ?? {};
+  const now = Date.now();
+  if (!shouldPublish(all[root], entry, now)) return false;
+  setShared(KEY, merged(all, root, entry, now));
+  return true;
+}
+
+export function contextFor(root) {
+  return (shared(KEY) ?? {})[root] ?? null;
+}
